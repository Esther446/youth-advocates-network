# Environment Variables Template
# Copy this file to .env and fill in your own values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Get this from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
MONGODB_URI=your_mongodb_connection_string_here

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
# Get these from Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (using Gmail SMTP)
# Use an App Password if 2FA is enabled on your Gmail account
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
FROM_NAME=Youth Action Network
FROM_EMAIL=your_gmail_address@gmail.com

# Frontend URL (used for CORS, email verification links, and password reset links)
# Example for local dev: http://localhost:5500
# Example for production: https://your-frontend-domain.vercel.app
FRONTEND_URL=http://localhost:5500
